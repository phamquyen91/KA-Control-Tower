# Auth.js — bắt buộc để tab "Tình hình kinh doanh" hoạt động.
#
# AUTH_SECRET: sinh bằng `npx auth secret`, hoặc `openssl rand -base64 32`.
AUTH_SECRET=

# Google OAuth client (loại "Web application"), tạo tại
# https://console.cloud.google.com/apis/credentials
# Authorized redirect URI phải khai đúng 2 dòng:
#   http://localhost:3000/api/auth/callback/google
#   https://ka-control-tower.vercel.app/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Tuỳ chọn: ghi đè allowlist mà không cần sửa code (các email cách nhau dấu phẩy).
# Bỏ trống thì dùng danh sách mặc định trong lib/access.ts
BIZ_ALLOWED_EMAILS=

# Tuỳ chọn: đổi domain app báo cáo nhúng ở tab Sức khoẻ vận hành.
NEXT_PUBLIC_KAS_ORIGIN=

# Đọc Google Sheet trực tiếp (tab Tình hình kinh doanh + Campaign).
#
# Bỏ trống → app dùng bản chụp trong lib/snapshot/* (số cũ, cập nhật tay).
# Có giá trị → app đọc sheet qua Sheets API mỗi giờ, sheet vẫn private.
#
# Cách tạo: Google Cloud Console → IAM & Admin → Service Accounts → Create
# → Keys → Add key (JSON). Rồi share sheet "tower control raw" cho email của
# service account với quyền Viewer. Dán nội dung file JSON vào đây — dán thẳng
# JSON hoặc bản base64 của nó (base64 an toàn hơn khi dán vào Vercel vì
# private_key có xuống dòng):  base64 -i key.json | tr -d '\n'
GOOGLE_SA_KEY=
